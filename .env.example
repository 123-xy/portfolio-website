# ============================================================
#  Premium Café — Environment Variables
#  Copy this file to `.env.local` and fill in real values.
#  The site runs fully with sample data even if these are empty.
# ============================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Database + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Payments) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Razorpay (alternative payment gateway) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Cloudinary (Image storage) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Email (order confirmations, e.g. Resend) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@premiumcafe.example
