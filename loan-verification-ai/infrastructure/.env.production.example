# Production environment template.
#
# Copy to `loan-verification-ai/.env` on the deployment host and fill in real
# values (generate secrets with `scripts/gen-secrets.sh`). NEVER commit the
# filled-in file. Consumed by:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# The prod overlay REQUIRES the secrets below — compose refuses to start if any
# is unset.

# --- Runtime ---
ENVIRONMENT=production

# --- Secrets (generate; do not reuse the dev defaults) ---
JWT_SECRET_KEY=            # long random string — scripts/gen-secrets.sh
POSTGRES_PASSWORD=         # strong random password
MINIO_ROOT_USER=          # object-storage access key
MINIO_ROOT_PASSWORD=      # object-storage secret key (>= 8 chars)

# --- Postgres ---
POSTGRES_USER=verify
POSTGRES_DB=verify

# --- Object storage ---
S3_BUCKET=verify-artifacts
# Public endpoint the BROWSER uses for presigned upload/download URLs. Must be
# the externally reachable object-storage URL (a real domain in production).
S3_PUBLIC_ENDPOINT_URL=https://storage.example.com
# For managed AWS S3 instead of the bundled MinIO, also set S3_ENDPOINT_URL to
# the S3 endpoint (or unset for AWS default) and don't start the minio services.

# --- Public origins / URLs ---
# Origin(s) the browser app is served from — used for CORS and bucket CORS.
CORS_ORIGINS=https://app.example.com
# Backend API base URL inlined into the frontend bundle at BUILD time. Must be
# the public URL the browser uses (behind nginx this is your app domain).
NEXT_PUBLIC_API_BASE_URL=https://app.example.com/api/v1
NEXT_PUBLIC_APP_NAME=VerifyCo

# --- TLS (nginx) ---
# Host directory holding fullchain.pem + privkey.pem, mounted read-only into
# nginx at /etc/nginx/certs. See docs/phase-15-deployment.md.
TLS_CERTS_DIR=/etc/letsencrypt/live/app.example.com
ACME_WEBROOT_DIR=/var/www/certbot

# --- Celery ---
WORKER_CONCURRENCY=4

# --- Monitoring (only if using docker-compose.monitoring.yml) ---
GRAFANA_ADMIN_PASSWORD=
