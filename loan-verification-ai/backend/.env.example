# Backend configuration. Copy to .env for local development.
# Secrets must never be committed — this file holds safe placeholders only.

ENVIRONMENT=development
DEBUG=true
APP_NAME=AI Co-Applicant Verification Platform
API_V1_PREFIX=/api/v1

# --- Database (async DSN, asyncpg) ---
DATABASE_URL=postgresql+asyncpg://verify:verify@localhost:5432/verify
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis (Celery broker / cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- Object storage (S3-compatible; MinIO in dev) ---
S3_ENDPOINT_URL=http://localhost:9000
# Only needed when the backend reaches storage by a name the browser can't
# resolve (e.g. `http://minio:9000` inside Docker Compose). Presigned URLs are
# signed against this so the browser can reach them. Leave unset for AWS S3 or
# any single-endpoint setup.
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=verify-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
