# --- Runtime / local object storage (MinIO data) ---
storage/*
!storage/README.md
!storage/.gitkeep

# --- Secrets / environment ---
.env
.env.*
!.env.example
!.env.docker.example
!.env.production.example

# --- TLS material (never commit real or self-signed keys) ---
docker/nginx/certs/
docker/nginx/certbot/
*.pem
*.key

# --- Python (backend, ai-services) ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Redis persistence snapshot (runtime artifact) ---
*.rdb

# --- Node / Next.js (frontend) ---
node_modules/
.next/
out/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- Playwright (frontend E2E) ---
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# --- AI model weights (large, fetched at build/runtime) ---
*.onnx
*.pt
*.bin
models/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# Next.js generated type shim (regenerated on build)
next-env.d.ts
