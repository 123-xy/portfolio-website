# Docker Compose configuration. Copy to `.env` in this directory to override
# the defaults baked into docker-compose.yml. Compose auto-loads `.env` for
# interpolation. This file holds SAFE PLACEHOLDERS ONLY — never commit real
# secrets. `docker compose up` works with no `.env` at all; set these to
# harden a real deployment.

# --- Runtime mode ---
ENVIRONMENT=development

# --- Postgres ---
POSTGRES_USER=verify
POSTGRES_PASSWORD=verify
POSTGRES_DB=verify

# --- Auth: MUST be a long random string in any real deployment ---
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string

# --- MinIO / object storage ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=verify-artifacts
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Endpoint the BROWSER uses for presigned upload/download URLs. Must match how
# a user's browser reaches MinIO — the host-published port by default.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# --- Published host ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- CORS: origins the browser app is served from (comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend build-time public config (inlined into the client bundle) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=VerifyCo

# --- Celery worker ---
WORKER_CONCURRENCY=2
